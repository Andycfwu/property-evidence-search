# Copy the exact Session Pooler URI from Supabase Dashboard > Connect.
# Session Pooler works on IPv4 networks and is suitable for local Prisma commands.
DATABASE_URL="postgresql://postgres.xwhssnrvigfaycqwiste:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Optional local vector retrieval. Lexical search works without these services.
VECTOR_STORE_PROVIDER=chroma
CHROMA_URL=http://localhost:8000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
